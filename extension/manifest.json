{
  "manifest_version": 3,
  "name": "Pink Bunny - YouTube Now Playing",
  "version": "12.0.3",
  "description": "YouTube/YouTube Music OBS widget with streaming readiness checks and acknowledged 2-PC media controls.",
  "permissions": [
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://www.youtube.com/*",
    "https://music.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Pink Bunny 연결 설정",
    "default_popup": "popup.html"
  },
  "optional_host_permissions": [
    "http://*/*"
  ]
}
