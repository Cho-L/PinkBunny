{
  "manifest_version": 3,
  "name": "Pink Bunny - YouTube Now Playing",
  "version": "11.1.0",
  "description": "YouTube and YouTube Music OBS widget: playlist next-track preview, transport controls, smart filters.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://www.youtube.com/*",
    "https://music.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Pink Bunny 연결 설정",
    "default_popup": "popup.html"
  }
}
